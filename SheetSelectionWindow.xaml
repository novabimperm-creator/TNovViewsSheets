<Window x:Class="TNovViewsSheets.SheetSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Экспорт листов"
        Width="1300" Height="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MinWidth="900" MinHeight="500">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style TargetType="GroupBox">
                <Setter Property="Margin" Value="0,0,0,8" />
                <Setter Property="Padding" Value="8" />
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="30"
                            ResizeBorderThickness="5"
                            GlassFrameThickness="0"
                            CornerRadius="12" />
    </shell:WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="White"
            BorderBrush="#FF008E43"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Верхняя панель (кастомный заголовок) -->
            <Border Height="30" CornerRadius="12 12 0 0"
    Background="#FF008E43" 
    VerticalAlignment="Top"
    MouseDown="Border_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource RoundButtonStyle}" 
Click="CloseHeaderButton_Click" Content="✕"
HorizontalAlignment="Center" VerticalAlignment="Center"
Width="20" Height="20" Margin="5,0"
WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource RoundButtonStyle2}" 
Click="HelpButton_Click" Content="?"
HorizontalAlignment="Center" VerticalAlignment="Center"
Width="20" Height="20" Margin="0"
WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock Text="Экспорт листов" 
Foreground="White"
VerticalAlignment="Center"
Margin="10,0"/>
                </StackPanel>

            </Border>

            <!-- Body -->
            <DockPanel Grid.Row="1" Margin="12">

                <!-- Bottom action buttons -->
                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,12,0,0">
                    <Button x:Name="OkButton"
                            Style="{StaticResource CustomButtonStyle}"
                            Content="Экспорт…"
                            MinWidth="110" MinHeight="28"
                            Padding="16,4"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="OkButton_Click" />
                    <Button x:Name="CancelButton"
                            Style="{StaticResource CustomButtonStyle}"
                            Content="Отмена"
                            MinWidth="100" MinHeight="28"
                            Padding="16,4"
                            IsCancel="True" />
                </StackPanel>

                <!-- Export options group -->
                <GroupBox DockPanel.Dock="Bottom" Header="Параметры экспорта">
                    <StackPanel>
                        <TextBlock Text="Формат вывода:" Margin="0,0,0,4" />
                        <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                            <CheckBox x:Name="FormatDwg" Content="DWG" IsChecked="True" Margin="0,0,16,0" />
                            <CheckBox x:Name="FormatPdf" Content="PDF" IsChecked="True" />
                        </StackPanel>

                        <GroupBox x:Name="DwgGroup" Header="DWG" Margin="0,6,0,0" Padding="6"
                                  IsEnabled="{Binding ElementName=FormatDwg, Path=IsChecked}">
                            <StackPanel>
                                <RadioButton x:Name="ModeMultiLayout"
                                             Content="Каждый лист — своя вкладка Layout"
                                             Margin="0,2" Visibility="Collapsed"/>
                                <RadioButton x:Name="ModeTiled"
                                             Content="Все листы рядом в Model Space"
                                             IsChecked="True" Margin="0,2" Visibility="Collapsed"/>

                                <TextBlock Text="DWG export setup:" Margin="0,8,0,4" Visibility="Collapsed"/>
                                <ComboBox x:Name="ExportSetupCombo" Width="300" HorizontalAlignment="Left" Visibility="Collapsed"/>

                                <TextBlock Text="Цвета:" Margin="0,8,0,4" />
                                <ComboBox x:Name="ColorModeCombo" Width="300" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="Задано в стилях объектов (True Color RGB)" Tag="TrueColor" />
                                    <ComboBoxItem Content="Задано в виде (True Color RGB)" IsSelected="True" Tag="TrueColorPerView" />
                                    <ComboBoxItem Content="Индексированные цвета (255)" Tag="IndexColors" />
                                </ComboBox>

                                <TextBlock Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#888" Visibility="Collapsed"
                                           Text="Layout: слияние через AutoCAD (нужен установленный AutoCAD). Model Space: только Revit, AutoCAD не запускается." />
                            </StackPanel>
                        </GroupBox>

                        <GroupBox x:Name="PdfGroup" Header="PDF" Margin="0,6,0,0" Padding="6"
                                  IsEnabled="{Binding ElementName=FormatPdf, Path=IsChecked}">
                            <StackPanel Orientation="Horizontal">
                                
                                <CheckBox x:Name="PdfColor"
Content="Цветная печать"
IsChecked="True" Margin="0,2,0,0" />
                                <CheckBox x:Name="PdfQuality"
          Content="Презентационное качество"
          IsChecked="False" Margin="10,2,0,0" />
                                <CheckBox x:Name="PdfRastr"
Content="Растровая обработка"
IsChecked="False" Margin="10,2,0,0" />
                                <CheckBox x:Name="PdfFitToSheet"
          Content="Печатать по размеру листа"
          IsChecked="True" Margin="10,2,0,0" />
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </GroupBox>

                <!-- Fill: sheets list (left) + splitter + preview (right) -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SheetListColumn" Width="*" MinWidth="420" />
                        <ColumnDefinition x:Name="SplitterColumn" Width="6" />
                        <ColumnDefinition x:Name="PreviewColumn" Width="520" MinWidth="240" />
                    </Grid.ColumnDefinitions>

                    <GroupBox x:Name="SheetListGroup" Grid.Column="0" Header="Листы" Margin="0,0,0,8">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                                <TextBlock Text="Поиск:" VerticalAlignment="Center" Margin="0,0,6,0" />
                                <TextBox x:Name="FilterBox" Width="200"
                                         TextChanged="FilterBox_TextChanged"
                                         VerticalContentAlignment="Center"
                                         ToolTip="Поиск по номеру, имени или стадии" />
                                <TextBlock Text="Комплект:" VerticalAlignment="Center" Margin="12,0,6,0" />
                                <ComboBox x:Name="StageCombo" Width="120"
                                          SelectionChanged="StageCombo_SelectionChanged" />
                                <Button Style="{StaticResource CustomButtonStyle}"
                                        Content="Все"
                                        MinWidth="70" MinHeight="24"
                                        Padding="10,3"
                                        Margin="12,0,4,0"
                                        Click="SelectAll_Click" />
                                <Button Style="{StaticResource CustomButtonStyle}"
                                        Content="Снять"
                                        MinWidth="70" MinHeight="24"
                                        Padding="10,3"
                                        Click="SelectNone_Click" />
                                <TextBlock x:Name="CountLabel" VerticalAlignment="Center"
                                           Margin="12,0,0,0" Foreground="#555" />
                            </StackPanel>

                            <ListView x:Name="SheetsList"
                                      SelectionMode="Extended"
                                      GridViewColumnHeader.Click="OnHeaderClick"
                                      SelectionChanged="SheetsList_SelectionChanged">
                                <ListView.View>
                                    <GridView>
                                        <GridViewColumn Width="40">
                                            <GridViewColumn.Header>
                                                <CheckBox x:Name="HeaderCheckBox"
                                                          Click="HeaderCheckBox_Click"
                                                          ToolTip="Toggle all visible" />
                                            </GridViewColumn.Header>
                                            <GridViewColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center" />
                                                </DataTemplate>
                                            </GridViewColumn.CellTemplate>
                                        </GridViewColumn>
                                        <GridViewColumn Header="Стадия" Width="80"
                                                        DisplayMemberBinding="{Binding Stage}" />
                                        <GridViewColumn Header="Номер" Width="110"
                                                        DisplayMemberBinding="{Binding SheetNumber}" />
                                        <GridViewColumn Header="Имя" Width="320"
                                                        DisplayMemberBinding="{Binding SheetName}" />
                                        <GridViewColumn Header="Placeholder" Width="80"
                                                        DisplayMemberBinding="{Binding IsPlaceholder}" />
                                    </GridView>
                                </ListView.View>
                            </ListView>
                        </DockPanel>
                    </GroupBox>

                    <GridSplitter x:Name="PreviewSplitter"
                                  Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="#E0E0E0"
                                  ShowsPreview="True"
                                  ResizeBehavior="PreviousAndNext"
                                  ToolTip="Потяните, чтобы изменить ширину превью" />

                    <GroupBox x:Name="PreviewGroup"
                              Grid.Column="2"
                              Header="Предпросмотр"
                              Margin="0,0,0,8"
                              MouseLeftButtonDown="PreviewGroup_MouseLeftButtonDown"
                              ToolTip="Двойной клик — развернуть на всё окно">
                        <Grid>
                            <Border BorderBrush="#CCC" BorderThickness="1" Background="#F8F8F8">
                                <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4" />
                            </Border>
                            <TextBlock x:Name="PreviewHint"
                                       Text="Выберите лист, чтобы увидеть превью"
                                       Foreground="#999"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </GroupBox>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
