<UserControl x:Class="TNovViewsSheets.DuplicateModeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <StackPanel>
        <TextBlock Text="Выберите исходный лист в списке справа" 
                   Margin="0,5" FontStyle="Italic" TextWrapping="Wrap"/>

        <TextBlock Text="Количество копий:" Margin="0,10,0,5"/>
        <TextBox x:Name="TbCopyCount" Margin="0,5" Text="1"/>

        <TextBlock Text="Начальный номер (если оставить пустым - подберётся автоматически):" 
                   Margin="0,10,0,5" TextWrapping="Wrap"/>
        <TextBox x:Name="TbStartNumber" Margin="0,5"/>

        <Button Content="Дублировать лист(ы) с содержимым" Margin="0,15" Padding="5" 
                Click="DuplicateSheets_Click"/>
    </StackPanel>
</UserControl>