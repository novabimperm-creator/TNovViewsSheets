<UserControl x:Class="TNovViewsSheets.ExportSchedulesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="Экспорт спецификаций"
                       Style="{StaticResource PanelHeaderStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Наборы спецификаций"
                       Foreground="{StaticResource AccentBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                <TextBlock Text="Набор:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="CbScheduleSets"
                          Width="180"
                          Style="{StaticResource DarkComboBoxStyle}"
                          SelectionChanged="CbScheduleSets_SelectionChanged"/>
                <Button Content="➕" Style="{StaticResource SecondaryButtonStyle}" Width="32" Padding="4" Margin="6,0,0,0" ToolTip="Создать новый набор" Click="AddSet_Click"/>
                <Button Content="✏" Style="{StaticResource SecondaryButtonStyle}" Width="32" Padding="4" Margin="4,0,0,0" ToolTip="Переименовать набор" Click="RenameSet_Click"/>
                <Button Content="🗑" Style="{StaticResource SecondaryButtonStyle}" Width="32" Padding="4" Margin="4,0,0,0" ToolTip="Удалить набор" Click="DeleteSet_Click"/>
                <Button Content="💾" Style="{StaticResource SecondaryButtonStyle}" Width="32" Padding="4" Margin="4,0,0,0" ToolTip="Сохранить набор" Click="SaveSet_Click"/>
            </StackPanel>

            <TextBlock Text="Опции экспорта"
                       Foreground="{StaticResource AccentBrush}"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Конфигурация:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <ComboBox x:Name="CbConfigs"
                          Width="180"
                          Style="{StaticResource DarkComboBoxStyle}"
                          SelectionChanged="CbConfigs_SelectionChanged"/>
                <Button Content="➕" Style="{StaticResource SecondaryButtonStyle}" Width="32" Padding="4" Margin="6,0,0,0" ToolTip="Создать конфигурацию" Click="AddConfig_Click"/>
                <Button Content="✏" Style="{StaticResource SecondaryButtonStyle}" Width="32" Padding="4" Margin="4,0,0,0" ToolTip="Переименовать конфигурацию" Click="RenameConfig_Click"/>
                <Button Content="🗑" Style="{StaticResource SecondaryButtonStyle}" Width="32" Padding="4" Margin="4,0,0,0" ToolTip="Удалить конфигурацию" Click="DeleteConfig_Click"/>
                <Button Content="💾" Style="{StaticResource SecondaryButtonStyle}" Width="32" Padding="4" Margin="4,0,0,0" ToolTip="Сохранить конфигурацию" Click="SaveConfig_Click"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Папка экспорта:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="TbOutputFolder"
                         Width="200"
                         Height="36"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Margin="0,0,8,0"/>
                <Button Content="Выбрать"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6"
                        Click="BrowseFolder_Click"/>
            </StackPanel>

            <ToggleButton x:Name="ChkSeparateFiles"
                          Style="{StaticResource CardToggleStyle}"
                          Margin="0,0,0,10">
                <TextBlock Text="Каждую спецификацию в отдельный файл" Style="{StaticResource CardTitleStyle}"/>
            </ToggleButton>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Префикс имени файла:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="TbFilePrefix"
                         Width="120"
                         Height="36"
                         Style="{StaticResource DarkTextBoxStyle}"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Имя файла:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="TbFileName"
                         Width="150"
                         Height="36"
                         Style="{StaticResource DarkTextBoxStyle}"/>
                <TextBlock Text=".xlsx"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <ToggleButton x:Name="ChkExportHeader"
                          Style="{StaticResource CardToggleStyle}"
                          Margin="0,0,0,6">
                <TextBlock Text="Экспортировать заголовок" Style="{StaticResource CardTitleStyle}"/>
            </ToggleButton>
            <ToggleButton x:Name="ChkKeepFormatting"
                          Style="{StaticResource CardToggleStyle}"
                          Margin="0,0,0,16">
                <TextBlock Text="Сохранить форматирование" Style="{StaticResource CardTitleStyle}"/>
            </ToggleButton>

            <WrapPanel HorizontalAlignment="Center">
                <Button Content="Экспорт текущей"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6"
                        Margin="0,0,6,0"
                        Click="ExportCurrent_Click"/>
                <Button Content="Экспорт"
                        Style="{StaticResource RunButtonStyle}"
                        Padding="10,6"
                        Margin="0,0,6,0"
                        Click="Export_Click"/>
                <Button Content="Закрыть"
                        Style="{StaticResource CloseButtonStyle}"
                        Padding="10,6"
                        Click="Close_Click"/>
            </WrapPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
