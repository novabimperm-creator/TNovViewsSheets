<UserControl x:Class="TNovViewsSheets.ExportSchedulesControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <UserControl.Resources>
        <!-- Стиль с полным шаблоном -->
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Убираем SystemColors -->
                        <ControlTemplate.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" 
                                 Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" 
                                 Color="Transparent"/>
                        </ControlTemplate.Resources>

                        <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Прямое указание цвета -->
                                <Setter TargetName="border" 
                            Property="Background" 
                            Value="#FF008E43"/>
                                <!-- Цвет заголовка -->
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" 
                            Property="Background" 
                            Value="#FF008E43"/>
                                <!-- Темнее -->
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" 
                            Property="Opacity" 
                            Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">
            <GroupBox Header="Наборы спецификаций" Margin="0,0,0,10" Padding="5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Набор:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CbScheduleSets" Width="180" SelectionChanged="CbScheduleSets_SelectionChanged"/>
                        <Button Content="➕" Width="25" Margin="5,0" ToolTip="Создать новый набор" Click="AddSet_Click" Style="{StaticResource CustomButtonStyle}"/>
                        <Button Content="✏️" Width="25" Margin="5,0" ToolTip="Переименовать набор" Click="RenameSet_Click" Style="{StaticResource CustomButtonStyle}"/>
                        <Button Content="🗑️" Width="25" Margin="5,0" ToolTip="Удалить набор" Click="DeleteSet_Click" Style="{StaticResource CustomButtonStyle}"/>
                        <Button Content="💾" Width="25" Margin="5,0" ToolTip="Сохранить набор" Click="SaveSet_Click" Style="{StaticResource CustomButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>

            <GroupBox Header="Опции экспорта" Margin="0,0,0,10" Padding="5">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Конфигурация:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <ComboBox x:Name="CbConfigs" Width="180" SelectionChanged="CbConfigs_SelectionChanged"/>
                        <Button Content="➕" Width="25" Margin="5,0" ToolTip="Создать конфигурацию" Click="AddConfig_Click" Style="{StaticResource CustomButtonStyle}"/>
                        <Button Content="✏️" Width="25" Margin="5,0" ToolTip="Переименовать конфигурацию" Click="RenameConfig_Click" Style="{StaticResource CustomButtonStyle}"/>
                        <Button Content="🗑️" Width="25" Margin="5,0" ToolTip="Удалить конфигурацию" Click="DeleteConfig_Click" Style="{StaticResource CustomButtonStyle}"/>
                        <Button Content="💾" Width="25" Margin="5,0" ToolTip="Сохранить конфигурацию" Click="SaveConfig_Click" Style="{StaticResource CustomButtonStyle}"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,10">
                        <TextBlock Text="Папка экспорта:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="TbOutputFolder" Width="200" Margin="5,0"/>
                        <Button Content="Выбрать" Width="60" Click="BrowseFolder_Click" Style="{StaticResource CustomButtonStyle}"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkSeparateFiles" Content="Каждую спецификацию в отдельный файл" Margin="0,5"/>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Префикс имени файла:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="TbFilePrefix" Width="100"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,5">
                        <TextBlock Text="Имя файла:" VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBox x:Name="TbFileName" Width="150"/>
                        <TextBlock Text=".xlsx" VerticalAlignment="Center" Margin="5,0"/>
                    </StackPanel>

                    <CheckBox x:Name="ChkExportHeader" Content="Экспортировать заголовок" Margin="0,5"/>
                    <CheckBox x:Name="ChkKeepFormatting" Content="Сохранить форматирование" Margin="0,5"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,15">
                        <Button Content="Экспорт текущей" Width="100" Margin="5" Click="ExportCurrent_Click" Style="{StaticResource CustomButtonStyle}"/>
                        <Button Content="Экспорт" Width="80" Margin="5" Click="Export_Click" Style="{StaticResource CustomButtonStyle}"/>
                        <Button Content="Закрыть" Width="80" Margin="5" Click="Close_Click" Style="{StaticResource CustomButtonStyle}"/>
                    </StackPanel>
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>