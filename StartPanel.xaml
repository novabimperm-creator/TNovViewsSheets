<UserControl x:Class="TNovViewsSheets.StartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <UserControl.Resources>
        <!-- Стиль с полным шаблоном -->
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Убираем SystemColors -->
                        <ControlTemplate.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" 
                                 Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" 
                                 Color="Transparent"/>
                        </ControlTemplate.Resources>

                        <Border x:Name="border"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Прямое указание цвета -->
                                <Setter TargetName="border" 
                            Property="Background" 
                            Value="#FF008E43"/>
                                <!-- Цвет заголовка -->
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" 
                            Property="Background" 
                            Value="#FF008E43"/>
                                <!-- Темнее -->
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" 
                            Property="Opacity" 
                            Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="5">
            <TextBlock Text="Добро пожаловать в Менеджер листов!" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>
            <TextBlock Text="Доступные функции:" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,10"/>
            <!-- Сформировать комплекты -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="☑ Комплекты листов и настройки префиксов" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Формирование комплектов листов на экспорт. Включение/выключение префиксов комплекта в системном параметре Номер листа, например 'АР 12' / '12'." 
TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Сформировать комплекты" Padding="5" HorizontalAlignment="Left" Click="GoToSheetPrintSets_Click" Style="{StaticResource CustomButtonStyle}"/>
                </StackPanel>
            </Border>
            <!-- Нумератор листов -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="🔢 Нумератор листов" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Автоматическая нумерация листов по заданным правилам. Позволяет быстро проставить номера на выбранных листах с учётом префиксов, разделов и т.д." 
       TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Перейти к нумератору" Padding="5" HorizontalAlignment="Left" Click="GoToSheetNumbering_Click" Style="{StaticResource CustomButtonStyle}"/>
                </StackPanel>
            </Border>
            <!-- Создание листов -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📄 Создание листов" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Создаёт указанное количество новых листов с выбранным типом штампа и комплектом. Номера и имена генерируются автоматически (Лист 1, Лист 2...)." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Перейти к созданию листов" Padding="5" HorizontalAlignment="Left" Click="GoToCreate_Click" Style="{StaticResource CustomButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- Создание видов -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="👁️ Создание видов" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Создаёт планы этажей (Floor Plans) с заданным шаблоном имени и количеством. Для планов этажей можно выбрать уровень и видовой шаблон." TextWrapping="Wrap"/>
                    <Button Content="Перейти к созданию видов" Padding="5" HorizontalAlignment="Left" Click="GoToCreateView_Click" Style="{StaticResource CustomButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- Экспорт PDF (только листы) 
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📑 Экспорт листов в PDF и DWG" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Экспорт выбранных листов в PDF (DWG) с настройками (объединение, масштаб, ориентация). Спецификации не поддерживаются." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Перейти к экспорту PDF и DWG" Padding="5" HorizontalAlignment="Left" Click="GoToExportPdf_Click"/>
                </StackPanel>
            </Border>

             Экспорт спецификаций в Excel 
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📊 Экспорт спецификаций в Excel" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Экспорт выбранных спецификаций в Excel с возможностью сохранения наборов и конфигураций." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Перейти к экспорту в Excel" Padding="5" HorizontalAlignment="Left" Click="GoToExportSchedules_Click"/>
                </StackPanel>
            </Border>

             Импорт из Excel 
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📥 Импорт из Excel" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Создаёт на листе Revit таблицу на основе данных из Excel. Поддерживаются файлы .xlsx и .xls." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Перейти к импорту" Padding="5" HorizontalAlignment="Left" Click="GoToImportExcel_Click"/>
                </StackPanel>
            </Border>
-->
            <!-- Копирование листа -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="📋 Копирование листа" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Создаёт копию выбранного листа с тем же штампом и параметрами, спецификациями и легендами, но без видов." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Перейти к копированию" Padding="5" HorizontalAlignment="Left" Click="GoToCopy_Click" Style="{StaticResource CustomButtonStyle}"/>
                </StackPanel>
            </Border>

            <!-- Дублирование листа с содержимым 
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="🔁 Дублирование листа с содержимым" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Создаёт одну или несколько точных копий выбранного листа со всеми размещёнными видами, размерами, текстом и т.д. Номера генерируются автоматически." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Перейти к дублированию" Padding="5" HorizontalAlignment="Left" Click="GoToDuplicate_Click"/>
                </StackPanel>
            </Border>
            -->
            <!-- Удаление листов -->
            <Border BorderBrush="LightGray" BorderThickness="1" CornerRadius="5" Padding="10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="🗑️ Удаление листов" FontSize="14" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="Позволяет выбрать один или несколько листов (с Shift/Ctrl) и удалить их. Доступны кнопки 'Выбрать все' и 'Сбросить все'." TextWrapping="Wrap" Margin="0,0,0,10"/>
                    <Button Content="Перейти к удалению" Padding="5" HorizontalAlignment="Left" Click="GoToDelete_Click" Style="{StaticResource CustomButtonStyle}"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>