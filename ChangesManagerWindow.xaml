<Window x:Class="TNovViewsSheets.ChangesManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="620" Height="680"
        MinWidth="1180" Width="1240"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="WrapCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DarkDataGridTextElementStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="6,6,6,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="МЕНЕДЖЕР ИЗМЕНЕНИЙ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="195"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource PanelFrameStyle}"
                        Margin="0,0,8,0"
                        Padding="8">
                    <StackPanel>
                        <Button x:Name="BtnRevisions"
                                Style="{StaticResource JournalNavButtonStyle}"
                                Click="BtnRevisions_Click"
                                ToolTip="Список изменений проекта">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📑" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Изменения" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnSheets"
                                Style="{StaticResource JournalNavButtonStyle}"
                                Click="BtnSheets_Click"
                                ToolTip="Параметры штампа и группы листов">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Листы" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnVedomost"
                                Style="{StaticResource JournalNavButtonStyle}"
                                Click="BtnVedomost_Click"
                                ToolTip="Итоговая ведомость изменений">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Ведомость" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Style="{StaticResource PanelFrameStyle}"
                        Padding="0">
                    <ContentControl x:Name="FunctionContent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
                </Border>
            </Grid>

            <TextBlock Grid.Row="2"
                       Margin="6,8,6,4"
                       Text="{Binding Status}"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Grid>
    </Border>
</Window>
