<Window x:Class="TNovViewsSheets.SheetsStartSimpleWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
        xmlns:local="clr-namespace:TNovViewsSheets"
        mc:Ignorable="d" 
        Width="400"
        WindowStartupLocation="CenterScreen" 
        AllowsTransparency="True"
Background="Transparent"
        ResizeMode="NoResize" 
        WindowStyle="None">
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/ButtonStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>
    <Border CornerRadius="12"
Background="White"
BorderBrush="#FF008E43"
BorderThickness="1">
        <Grid>
            <!-- Верхняя панель (кастомный заголовок) -->
            <Border Height="30" CornerRadius="12 12 0 0"
    Background="#FF008E43" 
    VerticalAlignment="Top"
    MouseDown="Border_MouseDown">
                <StackPanel Orientation="Horizontal">
                    <Button Style="{StaticResource RoundButtonStyle}" 
Click="escButton_Click" Content="✕"
HorizontalAlignment="Center" VerticalAlignment="Center"
Width="20" Height="20" Margin="5,0"
WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Style="{StaticResource RoundButtonStyle2}" 
Click="HelpButton_Click" Content="?"
HorizontalAlignment="Center" VerticalAlignment="Center"
Width="20" Height="20" Margin="0"
WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <TextBlock Text="Менеджер листов - комплекты и префиксы" 
Foreground="White"
VerticalAlignment="Center" 
Margin="10,0"/>
                </StackPanel>

            </Border>

            <!-- Основное содержимое -->
            <Border Margin="0,30,0,0">
                <StackPanel VerticalAlignment="Center" Margin="5">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"/>
                    <TextBlock HorizontalAlignment="Center" Text="Данная функция:" FontWeight="Bold"></TextBlock>
                    <TextBlock HorizontalAlignment="Center" Text="- собирает листы в комплекты на экспорт*" Width="350"></TextBlock>
                    <TextBlock HorizontalAlignment="Center" Text="*для инженерки листы .СО учитываются в основном комплекте" FontSize="10" Width="300"></TextBlock>
                    <TextBlock HorizontalAlignment="Center" Text="- добавляет/убирает префиксы** в системном Номере листа" Width="350"></TextBlock>
                    <TextBlock HorizontalAlignment="Center" Text="** примеры: АС1 10 (с префиксом) / 10 (без префикса)" FontSize="10" Width="300"></TextBlock>
                    <!-- CheckBox без привязки к ViewModel, с именем для доступа из code-behind -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0 10 0 0">
                        <CheckBox x:Name="prefixCheckBox" 
                              IsChecked="{Binding addPrefixes}"
                              Content="Добавить префиксы разделов в Номер листа" 
                              HorizontalAlignment="Left" 
                              Margin="5" 
                              BorderBrush="#CCCCCC"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Margin="5" TextWrapping="Wrap" VerticalAlignment="Center">
     <Hyperlink NavigateUri="https://portal.talan.group/knowledge/proektirovanie/listynumeratsiyaikomplektynaeksport/" 
                RequestNavigate="Hyperlink_RequestNavigate">
         Справка по функции
     </Hyperlink>
                        </TextBlock>
                        <Button Content="Отмена" 
                            x:Name="escButton" 
                            IsCancel="True" 
                            Click="escButton_Click" 
                            MinWidth="100" 
                            MinHeight="25" 
                            Margin="5 5 5 5" 
                            Style="{StaticResource CustomButtonStyle}" />
                        <Button Content="Применить" 
                            IsDefault="True"  
                            Click="acceptButton_Click" 
                            MinWidth="100" 
                            Margin="5" 
                            Style="{StaticResource CustomButtonStyle}" />
                    </StackPanel>


                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>