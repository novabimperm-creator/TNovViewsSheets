<UserControl x:Class="TNovViewsSheets.StartPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="Добро пожаловать в Менеджер листов"
                       Style="{StaticResource PanelHeaderStyle}"
                       FontSize="16"
                       HorizontalAlignment="Left"
                       Margin="0,0,0,4"/>
            <TextBlock Text="Выберите функцию на панели слева или перейдите к нужному разделу"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,16"/>

            <Border Style="{StaticResource ChangeCardStyle}">
                <StackPanel>
                    <TextBlock Text="☑ Комплекты листов и настройки префиксов"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Формирование комплектов листов на экспорт. Включение/выключение префиксов комплекта в системном параметре Номер листа, например «АР 12» / «12»."
                               Style="{StaticResource CardSubtitleStyle}"
                               Margin="0,0,0,10"/>
                    <Button Content="Сформировать комплекты"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            Click="GoToSheetPrintSets_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ChangeCardStyle}">
                <StackPanel>
                    <TextBlock Text="🔢 Нумератор листов"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Автоматическая нумерация листов по заданным правилам. Позволяет быстро проставить номера на выбранных листах с учётом префиксов, разделов и т.д."
                               Style="{StaticResource CardSubtitleStyle}"
                               Margin="0,0,0,10"/>
                    <Button Content="Перейти к нумератору"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            Click="GoToSheetNumbering_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ChangeCardStyle}">
                <StackPanel>
                    <TextBlock Text="📄 Создание листов"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Создаёт указанное количество новых листов с выбранным типом штампа и комплектом. Номера и имена генерируются автоматически (Лист 1, Лист 2...)."
                               Style="{StaticResource CardSubtitleStyle}"
                               Margin="0,0,0,10"/>
                    <Button Content="Перейти к созданию листов"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            Click="GoToCreate_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ChangeCardStyle}">
                <StackPanel>
                    <TextBlock Text="👁 Создание видов"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Создаёт планы этажей (Floor Plans) с заданным шаблоном имени и количеством. Для планов этажей можно выбрать уровень и видовой шаблон."
                               Style="{StaticResource CardSubtitleStyle}"
                               Margin="0,0,0,10"/>
                    <Button Content="Перейти к созданию видов"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            Click="GoToCreateView_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ChangeCardStyle}">
                <StackPanel>
                    <TextBlock Text="📋 Копирование листа"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Создаёт копию выбранного листа с тем же штампом и параметрами, спецификациями и легендами, но без видов."
                               Style="{StaticResource CardSubtitleStyle}"
                               Margin="0,0,0,10"/>
                    <Button Content="Перейти к копированию"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            Click="GoToCopy_Click"/>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource ChangeCardStyle}">
                <StackPanel>
                    <TextBlock Text="🗑 Удаление листов"
                               Style="{StaticResource CardTitleStyle}"
                               Margin="0,0,0,6"/>
                    <TextBlock Text="Позволяет выбрать один или несколько листов (с Shift/Ctrl) и удалить их. Доступны кнопки «Выбрать все» и «Сбросить все»."
                               Style="{StaticResource CardSubtitleStyle}"
                               Margin="0,0,0,10"/>
                    <Button Content="Перейти к удалению"
                            Style="{StaticResource SecondaryButtonStyle}"
                            Padding="10,6"
                            HorizontalAlignment="Left"
                            Click="GoToDelete_Click"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
