<Window x:Class="TNovViewsSheets.SheetSelectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Экспорт листов"
        Width="1300"
        Height="820"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ResizeMode="CanResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        MinWidth="900"
        MinHeight="500">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <Style x:Key="PanelBorderStyle" TargetType="Border">
                <Setter Property="Background" Value="{StaticResource CardBrush}"/>
                <Setter Property="BorderBrush" Value="{StaticResource SelectedBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="CornerRadius" Value="10"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>

            <Style x:Key="PanelTitleStyle" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleStyle}">
                <Setter Property="Foreground" Value="{StaticResource AccentBrush}"/>
                <Setter Property="FontWeight" Value="SemiBold"/>
                <Setter Property="FontSize" Value="13"/>
                <Setter Property="Margin" Value="0,0,0,10"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Padding="18,14,18,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ЭКСПОРТ ЛИСТОВ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="CloseHeaderButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <DockPanel Grid.Row="1" Margin="18,12,18,18">

                <StackPanel DockPanel.Dock="Bottom"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,4,0,0">
                    <Button x:Name="OkButton"
                            Style="{StaticResource RunButtonStyle}"
                            Content="Экспорт…"
                            MinWidth="120"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            IsDefault="True"
                            Click="OkButton_Click"/>
                    <Button x:Name="CancelButton"
                            Style="{StaticResource CloseButtonStyle}"
                            Content="Отмена"
                            MinWidth="100"
                            Padding="16,8"
                            IsCancel="True"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom" Style="{StaticResource PanelBorderStyle}">
                    <StackPanel>
                        <TextBlock Text="Параметры экспорта" Style="{StaticResource PanelTitleStyle}"/>

                        <TextBlock Text="Формат вывода"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <ToggleButton x:Name="FormatDwg"
                                          Style="{StaticResource CardToggleStyle}"
                                          IsChecked="True"
                                          MinWidth="120"
                                          Margin="0,0,8,0">
                                <TextBlock Text="DWG" Style="{StaticResource CardTitleStyle}"/>
                            </ToggleButton>
                            <ToggleButton x:Name="FormatPdf"
                                          Style="{StaticResource CardToggleStyle}"
                                          IsChecked="True"
                                          MinWidth="120"
                                          Margin="0">
                                <TextBlock Text="PDF" Style="{StaticResource CardTitleStyle}"/>
                            </ToggleButton>
                        </StackPanel>

                        <Border x:Name="DwgGroup"
                                Background="{StaticResource BgBrush}"
                                BorderBrush="{StaticResource SelectedBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                Margin="0,0,0,8"
                                IsEnabled="{Binding ElementName=FormatDwg, Path=IsChecked}">
                            <StackPanel>
                                <TextBlock Text="DWG" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,8"/>

                                <RadioButton x:Name="ModeMultiLayout"
                                             Style="{StaticResource DarkRadioButtonStyle}"
                                             Content="Каждый лист — своя вкладка Layout"
                                             Margin="0,2"
                                             Visibility="Collapsed"/>
                                <RadioButton x:Name="ModeTiled"
                                             Style="{StaticResource DarkRadioButtonStyle}"
                                             Content="Все листы рядом в Model Space"
                                             IsChecked="True"
                                             Margin="0,2"
                                             Visibility="Collapsed"/>

                                <TextBlock Text="DWG export setup:" Margin="0,8,0,4" Visibility="Collapsed"/>
                                <ComboBox x:Name="ExportSetupCombo"
                                          Width="300"
                                          HorizontalAlignment="Left"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          Margin="0"
                                          Visibility="Collapsed"/>

                                <TextBlock Text="Цвета"
                                           Foreground="{StaticResource MutedBrush}"
                                           FontSize="12"
                                           Margin="0,0,0,6"/>
                                <ComboBox x:Name="ColorModeCombo"
                                          Width="320"
                                          HorizontalAlignment="Left"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          Margin="0">
                                    <ComboBoxItem Content="Задано в стилях объектов (True Color RGB)" Tag="TrueColor"/>
                                    <ComboBoxItem Content="Задано в виде (True Color RGB)" IsSelected="True" Tag="TrueColorPerView"/>
                                    <ComboBoxItem Content="Индексированные цвета (255)" Tag="IndexColors"/>
                                </ComboBox>
                            </StackPanel>
                        </Border>

                        <Border x:Name="PdfGroup"
                                Background="{StaticResource BgBrush}"
                                BorderBrush="{StaticResource SelectedBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="10"
                                IsEnabled="{Binding ElementName=FormatPdf, Path=IsChecked}">
                            <StackPanel>
                                <TextBlock Text="PDF" Style="{StaticResource PanelTitleStyle}" Margin="0,0,0,8"/>
                                <WrapPanel>
                                    <ToggleButton x:Name="PdfColor"
                                                  Style="{StaticResource CardToggleStyle}"
                                                  IsChecked="True"
                                                  MinWidth="170"
                                                  Margin="0,0,8,8">
                                        <TextBlock Text="Цветная печать" Style="{StaticResource CardTitleStyle}"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="PdfQuality"
                                                  Style="{StaticResource CardToggleStyle}"
                                                  IsChecked="False"
                                                  MinWidth="220"
                                                  Margin="0,0,8,8">
                                        <TextBlock Text="Презентационное качество" Style="{StaticResource CardTitleStyle}"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="PdfRastr"
                                                  Style="{StaticResource CardToggleStyle}"
                                                  IsChecked="False"
                                                  MinWidth="190"
                                                  Margin="0,0,8,8">
                                        <TextBlock Text="Растровая обработка" Style="{StaticResource CardTitleStyle}"/>
                                    </ToggleButton>
                                    <ToggleButton x:Name="PdfFitToSheet"
                                                  Style="{StaticResource CardToggleStyle}"
                                                  IsChecked="True"
                                                  MinWidth="220"
                                                  Margin="0,0,0,8">
                                        <TextBlock Text="Печатать по размеру листа"
                                                   Style="{StaticResource CardTitleStyle}"
                                                   TextWrapping="Wrap"/>
                                    </ToggleButton>
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="SheetListColumn" Width="*" MinWidth="420"/>
                        <ColumnDefinition x:Name="SplitterColumn" Width="6"/>
                        <ColumnDefinition x:Name="PreviewColumn" Width="520" MinWidth="240"/>
                    </Grid.ColumnDefinitions>

                    <Border x:Name="SheetListGroup"
                            Grid.Column="0"
                            Style="{StaticResource PanelBorderStyle}"
                            Margin="0,0,8,0">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Листы"
                                       Style="{StaticResource PanelTitleStyle}"/>

                            <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                <TextBlock Text="Поиск:"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,6"/>
                                <TextBox x:Name="FilterBox"
                                         Width="200"
                                         Height="36"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Margin="0,0,12,6"
                                         TextChanged="FilterBox_TextChanged"
                                         ToolTip="Поиск по номеру, имени или стадии"/>
                                <TextBlock Text="Комплект:"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,6"/>
                                <ComboBox x:Name="StageCombo"
                                          Width="140"
                                          Height="36"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          Margin="0,0,12,6"
                                          SelectionChanged="StageCombo_SelectionChanged"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Все"
                                        MinWidth="70"
                                        Padding="10,6"
                                        Margin="0,0,6,6"
                                        Click="SelectAll_Click"/>
                                <Button Style="{StaticResource SecondaryButtonStyle}"
                                        Content="Снять"
                                        MinWidth="70"
                                        Padding="10,6"
                                        Margin="0,0,12,6"
                                        Click="SelectNone_Click"/>
                                <TextBlock x:Name="CountLabel"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource MutedBrush}"
                                           Margin="0,0,0,6"/>
                            </WrapPanel>

                            <DataGrid x:Name="SheetsList"
                                      Style="{StaticResource DarkDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      CanUserSortColumns="True"
                                      Sorting="SheetsList_Sorting"
                                      SelectionChanged="SheetsList_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="52" CanUserSort="False">
                                        <DataGridTemplateColumn.HeaderTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource TreeCheckToggleStyle}"
                                                              Click="HeaderCheckBox_Click"
                                                              ToolTip="Выбрать все видимые"
                                                              HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.HeaderTemplate>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource TreeCheckToggleStyle}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Стадия"
                                                        Binding="{Binding Stage}"
                                                        Width="90"
                                                        SortMemberPath="Stage"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                    <DataGridTextColumn Header="Номер"
                                                        Binding="{Binding SheetNumber}"
                                                        Width="110"
                                                        SortMemberPath="SheetNumber"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                    <DataGridTextColumn Header="Имя"
                                                        Binding="{Binding SheetName}"
                                                        Width="*"
                                                        MinWidth="180"
                                                        SortMemberPath="SheetName"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                    <DataGridTextColumn Header="Placeholder"
                                                        Binding="{Binding IsPlaceholder}"
                                                        Width="90"
                                                        SortMemberPath="IsPlaceholder"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </DockPanel>
                    </Border>

                    <GridSplitter x:Name="PreviewSplitter"
                                  Grid.Column="1"
                                  HorizontalAlignment="Stretch"
                                  VerticalAlignment="Stretch"
                                  Background="{StaticResource SelectedBrush}"
                                  ShowsPreview="True"
                                  ResizeBehavior="PreviousAndNext"
                                  ToolTip="Потяните, чтобы изменить ширину превью"/>

                    <Border x:Name="PreviewGroup"
                            Grid.Column="2"
                            Style="{StaticResource PanelBorderStyle}"
                            Margin="8,0,0,0"
                            MouseLeftButtonDown="PreviewGroup_MouseLeftButtonDown"
                            ToolTip="Двойной клик — развернуть на всё окно">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top"
                                       Text="Предпросмотр"
                                       Style="{StaticResource PanelTitleStyle}"/>
                            <Grid>
                                <Border BorderBrush="{StaticResource SelectedBrush}"
                                        BorderThickness="1"
                                        Background="{StaticResource BgBrush}"
                                        CornerRadius="8">
                                    <Image x:Name="PreviewImage" Stretch="Uniform" Margin="4"/>
                                </Border>
                                <TextBlock x:Name="PreviewHint"
                                           Text="Выберите лист, чтобы увидеть превью"
                                           Foreground="{StaticResource MutedBrush}"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           TextWrapping="Wrap"
                                           Margin="12"/>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </DockPanel>
        </Grid>
    </Border>
</Window>
