<Window x:Class="TNovViewsSheets.SheetsStartWPF"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TNovViewsSheets"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        WindowStyle="None">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30" ResizeBorderThickness="5" GlassFrameThickness="0" CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <StackPanel Margin="18">
            <Border MouseDown="TitleBar_MouseDown" Background="Transparent" Cursor="Arrow">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="МЕНЕДЖЕР ЛИСТОВ"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                    <Button Content="✕" Grid.Column="1" Style="{StaticResource CloseButtonStyleMini}"
                            Click="escButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <TextBlock Text="Выберите сценарий"
                       Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,12,0,16"/>

            <Button Content="Сформировать комплекты"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding scenario1}"
                    Margin="0,0,0,8"/>
            <Button Content="Перенумеровать листы"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Command="{Binding scenario2}"
                    Margin="0,0,0,12"/>

            <ToggleButton Style="{StaticResource CardToggleStyle}"
                          IsChecked="{Binding prefix, Mode=TwoWay}"
                          Margin="0,0,0,12">
                <TextBlock Text="Добавлять префиксы комплектов"
                           Style="{StaticResource CardTitleStyle}"/>
            </ToggleButton>

            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,0,0,16">
                <Hyperlink NavigateUri="https://portal.talan.group/knowledge/proektirovanie/listynumeratsiyaikomplektynaeksport/"
                           RequestNavigate="Hyperlink_RequestNavigate"
                           Style="{StaticResource MutedHyperlinkStyle}">Справка</Hyperlink>
            </TextBlock>

            <Button Content="Продолжить" Style="{StaticResource RunButtonStyle}" Click="acceptButton_Click"/>
            <Button Content="Отмена" Style="{StaticResource CloseButtonStyle}" x:Name="escButton"
                    IsCancel="True" Click="escButton_Click"/>
        </StackPanel>
    </Border>
</Window>
