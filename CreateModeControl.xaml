<UserControl x:Class="TNovViewsSheets.CreateModeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <TextBlock Text="Создание листов"
                       Style="{StaticResource PanelHeaderStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Семейство штампа (тип)"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="CbTitleBlocks"
                      Style="{StaticResource DarkComboBoxStyle}"
                      DisplayMemberPath="DisplayName"
                      SelectedValuePath="Symbol"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,10"/>

            <TextBlock Text="Формат и ориентация"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,6"/>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <ComboBox x:Name="CbFormat"
                          Grid.Column="0"
                          Style="{StaticResource DarkComboBoxStyle}"
                          IsEditable="True"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Format"
                          HorizontalAlignment="Stretch"
                          Margin="0"/>
                <ComboBox x:Name="CbOrientation"
                          Grid.Column="2"
                          Style="{StaticResource DarkComboBoxStyle}"
                          IsEditable="True"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="VerticalOrientation"
                          HorizontalAlignment="Stretch"
                          Margin="0"/>
            </Grid>

            <TextBlock Text="Комплект (A_Комплект чертежей)"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="CbSheetSets"
                      Style="{StaticResource DarkComboBoxStyle}"
                      IsEditable="True"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,10"/>

            <TextBlock Text="Количество листов"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="TbSheetCount"
                     Height="36"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Text="1"
                     HorizontalAlignment="Stretch"
                     Margin="0,0,0,16"/>

            <Button Content="Создать лист(ы)"
                    Style="{StaticResource RunButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Margin="0"
                    Click="CreateSheets_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
