<Window x:Class="TNovViewsSheets.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        MinHeight="580" Height="580"
        MinWidth="1090" Width="1090"
        WindowStartupLocation="CenterScreen"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStyle="None"
        ResizeMode="CanResize">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="WrapCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DarkDataGridTextElementStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Top"/>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="30"
                      ResizeBorderThickness="5"
                      GlassFrameThickness="0"
                      CornerRadius="12"/>
    </WindowChrome.WindowChrome>

    <Border CornerRadius="12"
            Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource AccentBrush}"
            BorderThickness="1">
        <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    MouseDown="TitleBar_MouseDown"
                    Background="Transparent"
                    Cursor="Arrow"
                    Margin="6,6,6,10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="35"/>
                        <ColumnDefinition Width="35"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="МЕНЕДЖЕР ЛИСТОВ"
                               Grid.Column="0"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="22"
                               FontWeight="Bold"
                               VerticalAlignment="Center"/>
                    <Button Content="i"
                            Grid.Column="1"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="HelpButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                    <Button Content="✕"
                            Grid.Column="2"
                            Style="{StaticResource CloseButtonStyleMini}"
                            Click="CloseButton_Click"
                            WindowChrome.IsHitTestVisibleInChrome="True"/>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="195"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="420"/>
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Style="{StaticResource PanelFrameStyle}"
                        Margin="0,0,8,0"
                        Padding="8">
                    <StackPanel>
                        <Button x:Name="BtnStart"
                                Style="{StaticResource JournalNavButtonStyle}"
                                Click="BtnStart_Click"
                                ToolTip="Главная">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🏠" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Главная" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnSheetPrintSets"
                                Style="{StaticResource JournalNavButtonStyle}"
                                Click="BtnSheetPrintSets_Click"
                                ToolTip="Комплекты листов и настройки префиксов">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="☑" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Комплекты" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnSheetNumbering"
                                Style="{StaticResource JournalNavButtonStyle}"
                                Click="BtnSheetNumbering_Click"
                                ToolTip="Нумератор листов">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🔢" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Нумератор" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnCreateMode"
                                Style="{StaticResource JournalNavButtonStyle}"
                                Click="BtnCreateMode_Click"
                                ToolTip="Создание листов">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📄" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Создание" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnCreateViewMode"
                                Style="{StaticResource JournalNavButtonStyle}"
                                Click="BtnCreateViewMode_Click"
                                ToolTip="Создание видов">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="👁" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Виды" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnCopyMode"
                                Style="{StaticResource JournalNavButtonStyle}"
                                Click="BtnCopyMode_Click"
                                ToolTip="Копирование листа (без видов)">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="📋" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Копирование" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnDeleteMode"
                                Style="{StaticResource JournalNavButtonStyle}"
                                Click="BtnDeleteMode_Click"
                                ToolTip="Удаление листов">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="🗑" FontSize="18" Width="28" TextAlignment="Center" VerticalAlignment="Center"/>
                                <TextBlock Text="Удаление" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnPhotoView"
                                Visibility="Collapsed"
                                Click="BtnPhotoView_Click"/>
                    </StackPanel>
                </Border>

                <Border x:Name="FunctionBorder"
                        Grid.Column="1"
                        Style="{StaticResource PanelFrameStyle}"
                        Padding="0">
                    <ContentControl x:Name="FunctionContent"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch"/>
                </Border>

                <Border x:Name="RightPanel"
                        Grid.Column="2"
                        Style="{StaticResource PanelFrameStyle}"
                        Margin="8,0,0,0"
                        Padding="8">
                    <Grid>
                        <Grid x:Name="SheetsPanel" Visibility="Visible">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Комплект:"
                                           Grid.Column="0"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="CbFilterSet"
                                          Grid.Column="1"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          Margin="8,0,0,0"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="CbFilterSet_SelectionChanged"/>
                            </Grid>
                            <DataGrid x:Name="LvSheets"
                                      Grid.Row="1"
                                      ItemsSource="{Binding SheetsView, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Style="{StaticResource DarkDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Extended"
                                      SelectionUnit="FullRow"
                                      HorizontalScrollBarVisibility="Disabled"
                                      SelectionChanged="LvSheets_SelectionChanged">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Номер"
                                                        Binding="{Binding SheetNumber}"
                                                        Width="64"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                    <DataGridTextColumn Header="Имя"
                                                        Binding="{Binding Name}"
                                                        Width="*"
                                                        MinWidth="40"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                                    <DataGridTextColumn Header="Комплект"
                                                        Binding="{Binding SheetSet}"
                                                        Width="72"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid x:Name="ViewsPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Существующие виды"
                                       Style="{StaticResource PanelHeaderStyle}"
                                       Margin="0,0,0,10"/>
                            <DataGrid x:Name="LvViews"
                                      Grid.Row="1"
                                      ItemsSource="{Binding ViewsView, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Style="{StaticResource DarkDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Имя"
                                                        Binding="{Binding Name}"
                                                        Width="*"
                                                        MinWidth="40"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                                    <DataGridTextColumn Header="Тип"
                                                        Binding="{Binding ViewFamily}"
                                                        Width="88"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid x:Name="SchedulesPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Поиск:"
                                           Grid.Column="0"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="TbScheduleFilter"
                                         Grid.Column="1"
                                         Height="36"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Margin="8,0,0,0"
                                         HorizontalAlignment="Stretch"
                                         TextChanged="ScheduleFilter_TextChanged"/>
                            </Grid>
                            <StackPanel Grid.Row="1" Margin="0,0,0,8">
                                <Button Content="Выбрать все видимые"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,6"
                                        HorizontalAlignment="Stretch"
                                        Click="SelectAllVisibleSchedules_Click"/>
                                <Button Content="Снять выбор"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,6"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Stretch"
                                        Click="DeselectAllVisibleSchedules_Click"/>
                            </StackPanel>
                            <TextBlock Grid.Row="2"
                                       x:Name="TbSelectedSchedulesCount"
                                       Text="Выбрано: 0"
                                       Foreground="{StaticResource MutedBrush}"
                                       Margin="0,0,0,10"
                                       HorizontalAlignment="Center"/>
                            <DataGrid x:Name="LvSchedules"
                                      Grid.Row="3"
                                      ItemsSource="{Binding SchedulesView, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Style="{StaticResource DarkDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="✓" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource TreeCheckToggleStyle}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Имя"
                                                        Binding="{Binding Name}"
                                                        Width="*"
                                                        MinWidth="40"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <Grid x:Name="ExportPanel" Visibility="Collapsed">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            <Grid x:Name="ExportSheetFilterPanel" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Комплект:"
                                           Grid.Column="0"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                                <ComboBox x:Name="CbExportFilterSet"
                                          Grid.Column="1"
                                          Style="{StaticResource DarkComboBoxStyle}"
                                          Margin="8,0,0,0"
                                          HorizontalAlignment="Stretch"
                                          SelectionChanged="CbExportFilterSet_SelectionChanged"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Поиск:"
                                           Grid.Column="0"
                                           Foreground="{StaticResource MutedBrush}"
                                           VerticalAlignment="Center"/>
                                <TextBox x:Name="TbExportSearch"
                                         Grid.Column="1"
                                         Height="36"
                                         Style="{StaticResource DarkTextBoxStyle}"
                                         Margin="8,0,0,0"
                                         HorizontalAlignment="Stretch"
                                         TextChanged="TbExportSearch_TextChanged"/>
                            </Grid>
                            <StackPanel Grid.Row="2" Margin="0,0,0,8">
                                <Button Content="Выбрать все"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,6"
                                        HorizontalAlignment="Stretch"
                                        Click="ExportSelectAll_Click"/>
                                <Button Content="Снять все"
                                        Style="{StaticResource SecondaryButtonStyle}"
                                        Padding="10,6"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Stretch"
                                        Click="ExportDeselectAll_Click"/>
                            </StackPanel>
                            <DataGrid x:Name="LvExport"
                                      Grid.Row="3"
                                      ItemsSource="{Binding ExportView, RelativeSource={RelativeSource AncestorType=Window}}"
                                      Style="{StaticResource DarkDataGridStyle}"
                                      ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                                      CellStyle="{StaticResource DarkDataGridCellStyle}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      CanUserDeleteRows="False"
                                      HeadersVisibility="Column"
                                      SelectionMode="Single"
                                      SelectionUnit="FullRow"
                                      HorizontalScrollBarVisibility="Disabled">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="✓" Width="44">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <ToggleButton Style="{StaticResource TreeCheckToggleStyle}"
                                                              IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Номер"
                                                        Binding="{Binding SheetNumber}"
                                                        Width="64"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource DarkDataGridTextElementStyle}"/>
                                    <DataGridTextColumn Header="Имя"
                                                        Binding="{Binding Name}"
                                                        Width="*"
                                                        MinWidth="40"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                                    <DataGridTextColumn Header="Комплект"
                                                        Binding="{Binding SheetSet}"
                                                        Width="72"
                                                        IsReadOnly="True"
                                                        ElementStyle="{StaticResource WrapCellTextStyle}"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Border>
</Window>
