<UserControl x:Class="TNovViewsSheets.CreateViewControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             HorizontalAlignment="Stretch"
             VerticalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="10">
            <TextBlock Text="Создание видов"
                       Style="{StaticResource PanelHeaderStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <TextBlock Text="Тип вида"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,6"/>
            <ComboBox x:Name="CbViewFamilyTypes"
                      Style="{StaticResource DarkComboBoxStyle}"
                      HorizontalAlignment="Stretch"
                      Margin="0,0,0,10"
                      SelectionChanged="CbViewFamilyTypes_SelectionChanged"/>

            <StackPanel x:Name="DraftingPanel" Margin="0,0,0,10">
                <TextBlock Text="Шаблон имени (используйте {#} для номера)"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TbDraftingNameTemplate"
                         Height="36"
                         Style="{StaticResource DarkTextBoxStyle}"
                         HorizontalAlignment="Stretch"
                         Text="Р_01_Этаж{#}"/>
            </StackPanel>

            <StackPanel x:Name="FloorPlanPanel" Visibility="Collapsed" Margin="0,0,0,10">
                <TextBlock Text="Уровень"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="CbLevels"
                          Style="{StaticResource DarkComboBoxStyle}"
                          HorizontalAlignment="Stretch"
                          Margin="0,0,0,10"/>

                <TextBlock Text="Шаблон имени ({#} — номер, {Level} — уровень)"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           TextWrapping="Wrap"
                           Margin="0,0,0,6"/>
                <TextBox x:Name="TbFloorPlanNameTemplate"
                         Height="36"
                         Style="{StaticResource DarkTextBoxStyle}"
                         HorizontalAlignment="Stretch"
                         Text="План {Level} {#}"
                         Margin="0,0,0,10"/>

                <TextBlock Text="Видовой шаблон (необязательно)"
                           Foreground="{StaticResource MutedBrush}"
                           FontSize="12"
                           Margin="0,0,0,6"/>
                <ComboBox x:Name="CbViewTemplates"
                          Style="{StaticResource DarkComboBoxStyle}"
                          HorizontalAlignment="Stretch"
                          Margin="0"/>
            </StackPanel>

            <TextBlock Text="Количество видов"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,6"/>
            <TextBox x:Name="TbViewCount"
                     Height="36"
                     Style="{StaticResource DarkTextBoxStyle}"
                     HorizontalAlignment="Stretch"
                     Text="1"
                     Margin="0,0,0,16"/>

            <Button Content="Создать вид(ы)"
                    Style="{StaticResource RunButtonStyle}"
                    HorizontalAlignment="Stretch"
                    Margin="0"
                    Click="CreateViews_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
