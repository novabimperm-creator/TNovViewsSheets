<UserControl x:Class="TNovViewsSheets.SheetNumControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             VerticalAlignment="Stretch"
             HorizontalAlignment="Stretch">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Нумератор листов"
                   Style="{StaticResource PanelHeaderStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Комплект:"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Width="70"
                       Margin="0,0,8,0"/>
            <ComboBox x:Name="TypeComboBox"
                      Width="150"
                      Style="{StaticResource DarkComboBoxStyle}"
                      Margin="0"
                      SelectionChanged="TypeComboBox_SelectionChanged"/>
            <Button x:Name="ApplyFilterButton"
                    Content="Отобразить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,6"
                    Margin="8,0,0,0"
                    Click="ApplyFilterButton_Click"/>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="Начальный номер:"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Width="120"
                       Margin="0,0,8,0"/>
            <TextBox x:Name="StartOrderTextBox"
                     Width="100"
                     Height="36"
                     Style="{StaticResource DarkTextBoxStyle}"
                     Text="0"/>
            <Button x:Name="RenumberButton"
                    Content="Пересчитать"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,6"
                    Margin="8,0,0,0"
                    Click="RenumberButton_Click"/>
        </StackPanel>

        <TextBlock x:Name="CurrentFilterText"
                   Grid.Row="3"
                   Foreground="{StaticResource AccentBrush}"
                   FontWeight="SemiBold"
                   Visibility="Hidden"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="4"
                BorderBrush="{StaticResource SelectedBrush}"
                BorderThickness="0,1,0,0"
                Padding="0,8,0,0"
                Margin="0,0,0,10"
                MinHeight="120">
            <ListView x:Name="ItemsListView"
                      AllowDrop="True"
                      PreviewMouseLeftButtonDown="ListView_PreviewMouseLeftButtonDown"
                      Drop="ListView_Drop"
                      DragOver="ListView_DragOver"
                      Background="Transparent"
                      BorderThickness="0"
                      Foreground="White">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Номер" Width="60" DisplayMemberBinding="{Binding TNovSheetNumericNumber}"/>
                        <GridViewColumn Header="Имя листа" Width="420">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding TNovSheetName}"
                                               Foreground="White"
                                               TextWrapping="Wrap"
                                               VerticalAlignment="Top"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
                <ListView.ItemContainerStyle>
                    <Style TargetType="ListViewItem">
                        <Setter Property="VerticalContentAlignment" Value="Top"/>
                        <Setter Property="Height" Value="Auto"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Background" Value="Transparent"/>
                    </Style>
                </ListView.ItemContainerStyle>
            </ListView>
        </Border>

        <Button Grid.Row="5"
                Content="Применить"
                Style="{StaticResource RunButtonStyle}"
                Margin="0"
                IsDefault="True"
                Click="acceptButton_Click"/>
    </Grid>
</UserControl>
