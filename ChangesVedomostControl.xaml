<UserControl x:Class="TNovViewsSheets.ChangesVedomostControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
            <Style x:Key="WrapCellTextStyle" TargetType="TextBlock" BasedOn="{StaticResource DarkDataGridTextElementStyle}">
                <Setter Property="TextWrapping" Value="Wrap"/>
                <Setter Property="VerticalAlignment" Value="Center"/>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Итоговая ведомость изменений"
                   Style="{StaticResource PanelHeaderStyle}"
                   HorizontalAlignment="Left"
                   Margin="0,0,0,8"/>

        <TextBlock Grid.Row="1"
                   Text="Сначала выберите комплект, затем изменение. Строки группируются по содержанию и значению «Лист» выбранного изменения. Группа записывается автоматически при обработке отмеченных листов."
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,10"/>

        <Grid Grid.Row="2" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="Комплект:"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox Grid.Column="1"
                      Style="{StaticResource DarkComboBoxStyle}"
                      ItemsSource="{Binding SheetSets}"
                      SelectedItem="{Binding FilterSet}"/>
            <TextBlock Grid.Column="3"
                       Text="Изменение:"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0"/>
            <ComboBox Grid.Column="4"
                      Style="{StaticResource DarkComboBoxStyle}"
                      ItemsSource="{Binding WorkingRevisions}"
                      SelectedItem="{Binding SelectedRevision}"
                      DisplayMemberPath="ListCaption"
                      IsEnabled="{Binding HasWorkingSet}"
                      Margin="0,0,8,0"/>
            <Button Grid.Column="5"
                    Content="Обновить"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Padding="10,6"
                    MinHeight="32"
                    Click="Refresh_Click"/>
        </Grid>

        <DataGrid Grid.Row="3"
                  ItemsSource="{Binding Vedomost}"
                  Style="{StaticResource DarkDataGridStyle}"
                  ColumnHeaderStyle="{StaticResource DarkDataGridColumnHeaderStyle}"
                  CellStyle="{StaticResource DarkDataGridCellStyle}"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  IsReadOnly="True"
                  HeadersVisibility="Column">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Изм." Binding="{Binding RevisionNumber}" Width="70"
                                    ElementStyle="{StaticResource WrapCellTextStyle}"/>
                <DataGridTextColumn Header="Номера листов" Binding="{Binding SheetNumbers}" Width="180"
                                    ElementStyle="{StaticResource WrapCellTextStyle}"/>
                <DataGridTextColumn Header="Кол.уч." Binding="{Binding CountText}" Width="70"
                                    ElementStyle="{StaticResource WrapCellTextStyle}"/>
                <DataGridTextColumn Header="Лист" Binding="{Binding SheetKind}" Width="80"
                                    ElementStyle="{StaticResource WrapCellTextStyle}"/>
                <DataGridTextColumn Header="Содержание" Binding="{Binding Description}" Width="*"
                                    ElementStyle="{StaticResource WrapCellTextStyle}"/>
                <DataGridTextColumn Header="Группа" Binding="{Binding Group}" Width="110"
                                    ElementStyle="{StaticResource WrapCellTextStyle}"/>
                <DataGridTextColumn Header="Листов" Binding="{Binding SheetCount}" Width="64"
                                    ElementStyle="{StaticResource WrapCellTextStyle}"/>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
