<UserControl x:Class="TNovViewsSheets.DuplicateModeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="12">
        <TextBlock Text="Дублирование листа"
                   Style="{StaticResource PanelHeaderStyle}"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>
        <TextBlock Text="Выберите исходный лист в списке справа"
                   Foreground="{StaticResource MutedBrush}"
                   FontStyle="Italic"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <TextBlock Text="Количество копий"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   Margin="0,0,0,6"/>
        <TextBox x:Name="TbCopyCount"
                 Height="36"
                 Style="{StaticResource DarkTextBoxStyle}"
                 Text="1"
                 Margin="0,0,0,10"/>

        <TextBlock Text="Начальный номер (пусто — подберётся автоматически)"
                   Foreground="{StaticResource MutedBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,6"/>
        <TextBox x:Name="TbStartNumber"
                 Height="36"
                 Style="{StaticResource DarkTextBoxStyle}"
                 Margin="0,0,0,16"/>

        <Button Content="Дублировать лист(ы) с содержимым"
                Style="{StaticResource RunButtonStyle}"
                Click="DuplicateSheets_Click"/>
    </StackPanel>
</UserControl>
