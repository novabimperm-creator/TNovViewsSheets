<UserControl x:Class="TNovViewsSheets.CopyModeControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="Auto" Width="Auto">
    <UserControl.Resources>
        <!-- Стиль с полным шаблоном -->
        <Style x:Key="CustomButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="#F0F0F0"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderBrush" Value="#CCCCCC"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- Убираем SystemColors -->
                        <ControlTemplate.Resources>
                            <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" 
                                     Color="Transparent"/>
                            <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" 
                                     Color="Transparent"/>
                        </ControlTemplate.Resources>

                        <Border x:Name="border"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="2">
                            <ContentPresenter HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <!-- Прямое указание цвета -->
                                <Setter TargetName="border" 
                                Property="Background" 
                                Value="#FF008E43"/>
                                <!-- Цвет заголовка -->
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>

                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="border" 
                                Property="Background" 
                                Value="#FF008E43"/>
                                <!-- Темнее -->
                            </Trigger>

                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="border" 
                                Property="Opacity" 
                                Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Text="Выберите исходный лист в списке справа" 
                   Margin="0,5" FontStyle="Italic" TextWrapping="Wrap"/>

        <TextBlock Text="Новое имя листа:" Margin="0,10,0,5"/>
        <TextBox x:Name="TbNewSheetName" Margin="0,5"/>
        <TextBlock Text="Настройки:" Margin="0,10,0,5"/>
        <CheckBox x:Name="copySchedules" Content="Копировать спецификации"  Margin="0,5" />
        <TextBlock Text="найти и заменить в имени и фильтрах спецификаций:" />
        <StackPanel Orientation="Horizontal">
            <TextBox x:Name="SpecName0" Margin="5" Height="25" Width="100"/>
            <TextBlock Text=">" Margin="0 10 0 0"/>
            <TextBox x:Name="SpecName1" Margin="5" Height="25" Width="100"/>
            <TextBlock Text="(только текстовые фильтры)" Margin="0 10 0 0"/>
        </StackPanel>
        <CheckBox x:Name="copyLegends" Content="Копировать легенды (без дублирования легенд в проекте)"  Margin="0,5" />
        <Button Content="Копировать лист" Margin="0,15" Padding="5" Click="CopySheet_Click" Style="{StaticResource CustomButtonStyle}"/>
    </StackPanel>
</UserControl>