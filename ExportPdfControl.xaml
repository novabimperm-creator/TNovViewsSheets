<UserControl x:Class="TNovViewsSheets.ExportPdfControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/TNovCommon;component/Styles.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="Экспорт в PDF / DWG"
                       Style="{StaticResource PanelHeaderStyle}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,12"/>

            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Папка экспорта:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="TbOutputFolder"
                         Width="240"
                         Height="36"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Margin="0,0,8,0"/>
                <Button Content="Выбрать"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Padding="10,6"
                        Click="BrowseFolder_Click"/>
            </StackPanel>

            <TextBlock Text="Формат экспорта"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="12"
                       Margin="0,0,0,8"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <RadioButton x:Name="RbFormatPdf"
                             GroupName="ExportFormat"
                             Style="{StaticResource CardRadioStyle}"
                             IsChecked="True"
                             Checked="Format_Checked"
                             Margin="0,0,8,0">
                    <TextBlock Text="PDF" Style="{StaticResource CardTitleStyle}"/>
                </RadioButton>
                <RadioButton x:Name="RbFormatDwg"
                             GroupName="ExportFormat"
                             Style="{StaticResource CardRadioStyle}"
                             Checked="Format_Checked">
                    <TextBlock Text="DWG" Style="{StaticResource CardTitleStyle}"/>
                </RadioButton>
            </StackPanel>

            <ToggleButton x:Name="ChkCombine"
                          Style="{StaticResource CardToggleStyle}"
                          Margin="0,0,0,10">
                <TextBlock Text="Объединить все выбранные в один PDF-файл"
                           Style="{StaticResource CardTitleStyle}"/>
            </ToggleButton>

            <StackPanel Orientation="Horizontal"
                        Margin="0,0,0,10"
                        x:Name="CombineFileNamePanel">
                <TextBlock Text="Имя итогового файла:"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="0,0,8,0"/>
                <TextBox x:Name="TbCombineFileName"
                         Width="200"
                         Height="36"
                         Style="{StaticResource DarkTextBoxStyle}"
                         Text="Имя файла"/>
                <TextBlock Text=".pdf"
                           Foreground="{StaticResource MutedBrush}"
                           VerticalAlignment="Center"
                           Margin="8,0,0,0"/>
            </StackPanel>

            <Expander x:Name="ExpanderOptions"
                      Header="Дополнительные параметры"
                      Foreground="{StaticResource MutedBrush}"
                      Margin="0,0,0,10">
                <StackPanel Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <TextBlock Text="Масштаб:"
                                   Foreground="{StaticResource MutedBrush}"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0"/>
                        <ComboBox x:Name="CbScale"
                                  Width="160"
                                  Style="{StaticResource DarkComboBoxStyle}"
                                  SelectedIndex="0">
                            <ComboBoxItem Content="По размеру страницы"/>
                            <ComboBoxItem Content="100%"/>
                            <ComboBoxItem Content="50%"/>
                            <ComboBoxItem Content="25%"/>
                        </ComboBox>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="RbPortrait"
                                     GroupName="Orientation"
                                     Style="{StaticResource DarkRadioButtonStyle}"
                                     IsChecked="True"
                                     Content="Книжная"/>
                        <RadioButton x:Name="RbLandscape"
                                     GroupName="Orientation"
                                     Style="{StaticResource DarkRadioButtonStyle}"
                                     Content="Альбомная"
                                     Margin="16,0,0,0"/>
                    </StackPanel>
                </StackPanel>
            </Expander>

            <Button Content="Экспорт"
                    Style="{StaticResource RunButtonStyle}"
                    HorizontalAlignment="Center"
                    Click="Export_Click"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
